#!/usr/bin/env bash
set -euo pipefail
rm -rf .robin/site
mkdir -p .robin/site/reference
for target in RobinCore RobinHTML RobinStyle RobinContent RobinForms RobinRouting RobinRuntime RobinData RobinCache RobinJobs RobinEmail RobinStorage RobinServer RobinAuth RobinBuild RobinTesting RobinTooling RobinTheme RobinLucide RobinPolar RobinPostgres; do
  swift package --scratch-path .build/docs --allow-writing-to-directory .robin/site generate-documentation --target "$target" --output-path ".robin/site/reference/$target" --transform-for-static-hosting --hosting-base-path "robin/reference/$target" --disable-indexing --warnings-as-errors --experimental-skip-synthesized-symbols --experimental-documentation-coverage --coverage-summary-level brief
done
missing=$(
  for report in .robin/site/reference/*/documentation-coverage.json; do
    jq -r '.[] | select(.kind.isSymbol == true and .hasAbstract == false) | select((.kind.name | startswith("Extended ")) | not) | select(.title != "init(rawValue:)" and .title != "init(from:)" and .title != "<(_:_:)") | .referencePath' "$report"
  done
)
if [ -n "$missing" ]; then printf 'Undocumented public symbols:\n%s\n' "$missing" >&2; exit 1; fi
swift .mise/tasks/check-documentation --self-test
swift .mise/tasks/check-documentation
swift run --scratch-path .build/docs RobinDocumentation
(cd Templates/marketing && swift run --scratch-path .build/mise -- __PROJECT__ --github-pages)
cp -R Templates/marketing/.robin/build/. .robin/site/
swift .mise/tasks/assemble-pages
