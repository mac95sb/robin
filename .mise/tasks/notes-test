#!/usr/bin/env python3
#MISE description="Test release-note generation offline with fake Communique and git executables"
"""Exercise the real mise usage parser and release-notes shell, without API calls."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[2]
TASK = '[tasks.release-notes]' + (ROOT / 'mise.toml').read_text().split('[tasks.release-notes]', 1)[1]
MISE = shutil.which('mise')
GIT = shutil.which('git')
FAKE = r'''
import json
import os
from pathlib import Path
import sys
import tomllib

args = sys.argv[1:]
config_path = Path(args[args.index('--config') + 1]) if '--config' in args else None
Path('invocation.json').write_text(json.dumps({
    'config_path': str(config_path) if config_path else None,
    'config': tomllib.loads(config_path.read_text()) if config_path else None,
    'config_mode': config_path.stat().st_mode & 0o777 if config_path else None,
    'args': args, 'github_token_present': 'GITHUB_TOKEN' in os.environ,
    'key_present': bool(os.environ.get('OPENAI_API_KEY')),
}))
if os.environ.get('MOCK_FAIL'):
    sys.exit(17)
text = '# Unreleased\n\n[change](https://github.com/mac95sb/robin/commit/abcdef1234567)\n'
if os.environ.get('MOCK_LINK'):
    text += '[unverified PR](https://github.com/mac95sb/robin/pull/42)\n'
for flag in ('--output', '--draft', '--review-report', '--migration-guide'):
    path = Path(args[args.index(flag) + 1])
    content = json.dumps({'release_body': text}) if flag == '--draft' else text
    path.write_text('' if os.environ.get('MOCK_EMPTY') else content)
'''


class NotesTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        (self.root / 'mise.toml').write_text(TASK)
        shutil.copyfile(ROOT / 'communique.toml', self.root / 'communique.toml')
        self.bin = self.root / 'bin'
        self.bin.mkdir()
        for name, source in [
            ('communique', FAKE),
            ('git', "import sys\n"
                    "if 'tag' in sys.argv:\n    print('v0.8.0')\n"
                    "elif sys.argv[-1] not in ('HEAD^{commit}', 'v0.9.0^{commit}'):\n    sys.exit(1)\n"),
        ]:
            executable = self.bin / name
            executable.write_text('#!' + sys.executable + '\n' + source)
            executable.chmod(0o755)
        # Do not inherit credentials or dotenv configuration from the checkout.
        self.env = {key: value for key, value in os.environ.items()
                    if not key.startswith(('MISE_', 'COMMUNIQUE_', 'OPENAI_', 'ANTHROPIC_',
                                           'GITHUB_', 'FORGEJO_', 'LLM_', 'usage_', 'MOCK_'))}
        self.env.update(PATH=str(self.bin) + os.pathsep + os.environ['PATH'],
                        MISE_TRUSTED_CONFIG_PATHS=str(self.root),
                        MISE_NO_AUTO_INSTALL='1', MISE_OFFLINE='1',
                        OPENAI_API_KEY='offline-fixture-not-a-secret', GITHUB_TOKEN='must-be-unset')

    def run_task(self, *args, success=True, **env):
        result = subprocess.run([MISE, 'run', 'release-notes', '--', *args], cwd=self.root,
                                env=dict(self.env, **env), capture_output=True, text=True, timeout=30)
        if success:
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        else:
            self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
        return result

    def invocation(self):
        return json.loads((self.root / 'invocation.json').read_text())

    def test_head_default_and_all_artifacts(self):
        self.run_task()
        call = self.invocation()
        self.assertEqual(call['args'], [
            'generate', 'HEAD', '--dry-run', '--output', '.robin/releases/HEAD.md',
            '--draft', '.robin/releases/HEAD.draft.json',
            '--review-report', '.robin/releases/HEAD.review.md',
            '--migration-guide', '.robin/releases/HEAD.migration.md',
        ])
        self.assertFalse(call['github_token_present'])
        self.assertTrue(call['key_present'])
        self.assertEqual(sorted(p.name for p in (self.root / '.robin/releases').iterdir()),
                         ['HEAD.draft.json', 'HEAD.md', 'HEAD.migration.md', 'HEAD.review.md'])
        for path in (self.root / '.robin/releases').iterdir():
            text = path.read_text()
            self.assertIn('https://git.maclong.dev/mac/robin/commit/abcdef1234567', text)
            self.assertNotIn('github.com/mac95sb/robin', text)
        json.loads((self.root / '.robin/releases/HEAD.draft.json').read_text())
        self.assertFalse((self.root / '.forgejo').exists())

    def real_git(self, *args):
        return subprocess.check_output(
            [GIT, '--no-pager', '-c', 'core.hooksPath=/dev/null',
             '-c', 'user.name=Offline Fixture', '-c', 'user.email=fixture@example.invalid',
             '-c', 'commit.gpgsign=false', '-c', 'tag.gpgsign=false', *args], cwd=self.root,
            env=dict(self.env, GIT_EDITOR='true'), text=True, stderr=subprocess.PIPE).strip()

    def first_release_repository(self):
        # Only this temporary fixture gets commits/tags; never mutate the checkout.
        (self.bin / 'git').unlink()
        self.real_git('init', '--quiet')
        (self.root / 'Root.swift').write_text('let greeting = "Root \\u0001 \\U0001f331"\n')
        self.real_git('add', '--', 'Root.swift')
        self.real_git('commit', '--quiet', '-m', 'Initial public API "root"')
        root = self.real_git('rev-parse', 'HEAD')
        (self.root / 'Root.swift').write_text('let greeting = "Later revision"\n')
        self.real_git('add', '--', 'Root.swift')
        self.real_git('commit', '--quiet', '-m', 'Later public API')
        return root

    def test_real_git_first_release_supplements_root_and_preserves_config(self):
        import tomllib

        root = self.first_release_repository()

        original = (self.root / 'communique.toml').read_bytes()
        result = self.run_task('HEAD', '--label', 'v1.0.0')
        call = self.invocation()
        self.assertEqual(call['args'][:3], ['--config', call['config_path'], 'generate'])
        self.assertEqual(call['config_mode'], 0o600)
        self.assertFalse(Path(call['config_path']).exists())
        augmented = call['config']
        previous = tomllib.loads(original.decode())
        context = augmented.pop('context')
        self.assertEqual(augmented, {k: v for k, v in previous.items() if k != 'context'})
        self.assertTrue(context.startswith(previous['context']))
        for detail in (root, 'Initial public API "root"', 'Offline Fixture',
                       'diff --git a/Root.swift b/Root.swift', '+let greeting = "Root'):
            self.assertIn(detail, context)
        self.assertNotIn('offline-fixture-not-a-secret', context)
        self.assertNotIn('must-be-unset', context)
        self.assertIn('First-release root supplement added', result.stderr)
        self.assertIn('Automatic coverage excludes', result.stderr)
        report = (self.root / '.robin/releases/v1.0.0.review.md').read_text()
        self.assertIn(root, report)
        self.assertIn('Automatic coverage excludes', report)
        self.assertEqual((self.root / 'communique.toml').read_bytes(), original)
        self.assertEqual(self.real_git('tag', '--list'), '')
        self.assertEqual(self.real_git('rev-list', '--count', 'HEAD'), '2')

    def test_real_git_baseline_skips_supplement(self):
        root = self.first_release_repository()
        self.real_git('tag', 'v0.1.0', root)
        result = self.run_task()
        self.assertIsNone(self.invocation()['config_path'])
        self.assertNotIn('First-release root supplement', result.stderr)

    def test_real_git_temporary_config_removed_after_generation_failure(self):
        self.first_release_repository()
        self.run_task(success=False, MOCK_FAIL='1')
        self.assertFalse(Path(self.invocation()['config_path']).exists())

    def test_pre_tag_label_only_changes_filenames(self):
        self.run_task('HEAD', '--label', 'v1.0.0')
        self.assertEqual(self.invocation()['args'][1], 'HEAD')
        self.assertTrue((self.root / '.robin/releases/v1.0.0.md').exists())

    def test_existing_tag(self):
        self.run_task('v0.9.0')
        self.assertEqual(self.invocation()['args'][1], 'v0.9.0')

    def test_optional_model_override_is_one_argument(self):
        self.run_task(COMMUNIQUE_MODEL='model-with-tool-calling')
        self.assertEqual(self.invocation()['args'][2:4], ['--model', 'model-with-tool-calling'])

    def test_empty_model_uses_config_default(self):
        self.run_task(COMMUNIQUE_MODEL='')
        self.assertNotIn('--model', self.invocation()['args'])

    def test_missing_key_and_missing_tag_fail_before_generation(self):
        self.run_task(OPENAI_API_KEY='', success=False)
        self.run_task('v1.0.0', success=False)
        self.assertFalse((self.root / 'invocation.json').exists())

    def test_invalid_arguments_never_invoke_communique(self):
        for args in [('main',), ('../escape',), ('v01.0.0',), ('v1.0.0-01',),
                     ('v1.0.0-rc..1',), ('HEAD\n',), ('HEAD', '--label', '../escape'),
                     ('HEAD', '--label', 'HEAD'), ('HEAD', '--label'),
                     ('HEAD', 'extra'), ('--github-release',), ('--unknown',)]:
            with self.subTest(args=args):
                self.run_task(*args, success=False)
                self.assertFalse((self.root / 'invocation.json').exists())
                self.assertFalse((self.root / '.robin').exists())

    def test_semantic_labels(self):
        for label in ['v1.0.0-rc.1', 'v1.0.0+build.5', 'v1.0.0-0+build-5']:
            with self.subTest(label=label):
                self.run_task('HEAD', '--label', label)
                self.assertTrue((self.root / '.robin/releases' / (label + '.md')).exists())

    def test_generation_failure_and_empty_output_fail(self):
        self.run_task(success=False, MOCK_FAIL='1')
        self.run_task(success=False, MOCK_EMPTY='1')

    def test_unverified_mirror_link_is_not_translated(self):
        result = self.run_task(success=False, MOCK_LINK='1')
        self.assertIn('Unresolved GitHub mirror link', result.stderr)
        text = (self.root / '.robin/releases/HEAD.md').read_text()
        self.assertNotIn('git.maclong.dev/mac/robin/pulls/42', text)


if __name__ == '__main__':
    unittest.main()
