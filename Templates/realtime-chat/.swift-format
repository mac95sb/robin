{
  "indentation" : {
    "spaces" : 2
  },
  "lineBreakAroundMultilineExpressionChainComponents" : true,
  "lineBreakBeforeEachArgument" : true,
  "lineLength" : 120,
  "maximumBlankLines" : 1,
  "multiElementCollectionTrailingCommas" : true,
  "reflowMultilineStringLiterals" : {
    "onlyLinesOverLength" : {}
  },
  "respectsExistingLineBreaks" : true,
  "version" : 1
}
