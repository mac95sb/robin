@Tutorial(time: 5) {
  @Intro(title: "Parse Markdown Content") {
    Convert Markdown into typed content while reporting unsupported input.
  }

  @Section(title: "Parse and inspect") {
    Convert Markdown into typed content while reporting unsupported input.

    @Steps {
      @Step {
        Add this file to an executable target depending on RobinContent and RobinHTML. Parse Markdown with an explicit embed allowlist, then render the typed result.

        @Code(name: "MarkdownPage.swift", file: "MarkdownPage.swift")
      }

      @Step {
        Run the target. It prints a heading and paragraph containing `<strong>Markdown</strong>`. Inspect `diagnostics` before publishing; an empty array means this input needed no unsupported-content warnings.
      }
    }
  }
}
