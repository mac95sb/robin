@Tutorial(time: 5) {
  @Intro(title: "Connect State and Actions") {
    Choose browser-local state or asynchronous Swift-side operations.
  }

  @Section(title: "Keep state typed") {
    @Steps {
      @Step {
        For local UI changes, declare `@State`, bind the projected value with `$value`, and attach typed operations to buttons. See <doc:Browser-State>.
      }

      @Step {
        Store server-owned values in ``StateStore`` and expose selected values through ``Binding``.
      }

      @Step {
        Represent asynchronous Swift-side operations with ``Action``. These are not browser-local ``StateAction`` operations.
      }
    }
  }
}
