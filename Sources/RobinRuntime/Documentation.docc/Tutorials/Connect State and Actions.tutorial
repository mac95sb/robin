@Tutorial(time: 5) {
  @Intro(title: "Connect State and Actions") {
    Choose browser-local state or asynchronous Swift-side operations.
  }

  @Section(title: "Keep state typed") {
    Choose browser-local state or asynchronous Swift-side operations.

    @Steps {
      @Step {
        Add this component to a page in a Robin application. The projected `$count` binds the input and text to the same integer; actions use ordinary Swift mutations.

        @Code(name: "Counter.swift", file: "Counter.swift")
      }

      @Step {
        Build and open the page in a browser. Click +10 twice to display 20, type 7 into the input to display 7, then Reset to display 0. Robin includes the shared state runtime automatically. Reloading restores 0: this is document-local UI state, not durable server data. See <doc:Browser-State> for Boolean, string, and floating-point bindings.
      }
    }
  }
}
