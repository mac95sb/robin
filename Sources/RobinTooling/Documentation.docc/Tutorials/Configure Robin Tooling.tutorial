@Tutorial(time: 5) {
  @Intro(title: "Configure Robin Tooling") {
    Keep build and diagnostic policy separate from application behavior.
  }

  @Section(title: "Set project policy") {
    Keep build and diagnostic policy separate from application behavior.

    @Steps {
      @Step {
        Save this policy as `robin.pkl` at the application project root. It sets diagnostic severity and the build budget without changing routes, services, or page content.

        @Code(name: "robin.pkl", file: "robin.pkl")
      }

      @Step {
        From the same directory run `robin lint`, then `robin doctor`. Fix reported configuration or environment problems before building. A valid policy uses schema version 1 and a positive budget; try changing the budget to 0 to see policy validation fail, then restore it. Keep application behavior in `App.swift`.
      }
    }
  }
}
