@Tutorial(time: 5) {
  @Intro(title: "Style a Component") {
    Apply typed design tokens and compile only the CSS each page reaches.
  }

  @Section(title: "Use typed styles") {
    Apply typed design tokens and compile only the CSS each page reaches.

    @Steps {
      @Step {
        Add `WelcomeCard` to a Robin application and place it inside a page body. Import RobinStyle to use the grouped modifiers.

        @Code(name: "StyledCard.swift", file: "StyledCard.swift")
      }

      @Step {
        Build and preview the application with its default theme. Below the medium breakpoint the card uses small padding; at medium and wider it uses large padding. Hover the link to see its color change. These conditions compile to CSS and require no browser state or JavaScript.
      }
    }
  }
}
