@Tutorial(time: 5) {
  @Intro(title: "Send a Magic Link") {
    Build and send the framework's secure passwordless sign-in email.
  }

  @Section(title: "Render and deliver") {
    @Steps {
      @Step {
        Create an HTTPS message with ``MagicLinkEmail``.

        @Code(name: "MagicLinkDelivery.swift", file: "SendAMagicLink-01.swift")
      }

      @Step {
        Preview it locally with ``DevelopmentMailbox``.

        @Code(name: "MagicLinkDelivery.swift", file: "SendAMagicLink-02.swift")
      }

      @Step {
        Deliver it in production with ``SMTPEmailSender`` and an explicit ``EmailEnvelope``.

        @Code(name: "MagicLinkDelivery.swift", file: "SendAMagicLink-03.swift", reset: true)
      }
    }
  }
}
