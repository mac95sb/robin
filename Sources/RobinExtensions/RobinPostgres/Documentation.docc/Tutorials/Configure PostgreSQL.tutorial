@Tutorial(time: 5) {
  @Intro(title: "Configure PostgreSQL") {
    Start a verified connection pool without exposing PostgresNIO to application repositories.
  }

  @Section(title: "Create the adapter") {
    @Steps {
      @Step {
        Construct ``PostgresConfiguration`` from the application's typed environment and secret values.
      }

      @Step {
        Require TLS outside local development and choose a bounded maximum connection count.
      }

      @Step {
        Create ``PostgresDatabase`` and pass it to the same `RepositoryContext` used with SQLite.
      }
    }
  }
}
