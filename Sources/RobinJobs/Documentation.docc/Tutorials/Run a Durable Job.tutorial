@Tutorial(time: 10) {
  @Intro(title: "Run a Durable Job") {
    Schedule typed work in SQLite and execute it with a worker.
  }

  @Section(title: "Enqueue and handle work") {
    @Steps {
      @Step {
        Define a `Codable & Sendable` ``Job`` with a stable name.
      }

      @Step {
        Enqueue it through ``JobClient`` with an explicit tenant and idempotency key.
      }

      @Step {
        Register an ``AnyJobHandler`` and run ``JobWorker`` through `robin worker`.
      }
    }
  }
}
