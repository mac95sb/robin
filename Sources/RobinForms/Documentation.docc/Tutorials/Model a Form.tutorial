@Tutorial(time: 5) {
  @Intro(title: "Model a Form") {
    Give form fields stable, typed names shared by rendering and request decoding.
  }

  @Section(title: "Declare fields") {
    Give form fields stable, typed names shared by rendering and request decoding.

    @Steps {
      @Step {
        Declare the form and decode a URL-encoded submission. Call `validated()` before saving data; it throws when a constraint fails.

        @Code(name: "ProfileForm.swift", file: "ProfileForm.swift")
      }

      @Step {
        Run the example in a target depending on RobinForms and RobinHTML. The valid name is Robin. The empty submission has validation errors; render `redisplayedForm` to show those errors beside the retained field value. In a server handler, decode the actual request body rather than the sample bytes.
      }
    }
  }
}
