@Tutorial(time: 5) {
  @Intro(title: "Model a Form") {
    Give form fields stable, typed names shared by rendering and request decoding.
  }

  @Section(title: "Declare fields") {
    @Steps {
      @Step {
        Apply ``FormModel()`` to a structure and declare default-valued ``Field`` properties.
        Set stable names, labels, required values, length constraints, and custom validation.
        Use ``FileField`` for uploads.
      }

      @Step {
        Render projected fields inside `RobinHTML.Form`. Decode submissions with RobinServer's
        `request.form`, then call `validated()` before changing stored data. Redisplay invalid
        forms with ``FormErrorSummary`` and projected fields to preserve entered text.
      }
    }
  }
}
