@Tutorial(time: 5) {
  @Intro(title: "Test an Application") {
    Check routes, accessibility, snapshots, and browser behavior through Robin's public contracts.
  }

  @Section(title: "Choose the smallest test") {
    Check routes, accessibility, snapshots, and browser behavior through Robin's public contracts.

    @Steps {
      @Step {
        Place this file in a Swift Testing test target with RobinTesting and the imported Robin modules as dependencies.

        @Code(name: "ApplicationTests.swift", file: "ApplicationTests.swift")
      }

      @Step {
        Run `swift test --filter homeResponds` in that project. The route responds with HTTP 200 and the accessibility audit returns no findings. Neither check starts a network listener. Use browser tests separately for interactions that require a real DOM.
      }
    }
  }
}
